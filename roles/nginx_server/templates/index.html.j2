{% set ldap_base_dn = openldap_base_dn | default('dc=example,dc=lan') %}
{% set ldap_admin_dn = openldap_admin_dn | default('cn=admin,' + ldap_base_dn) %}
{% set phpldapadmin_port = phpldapadmin_http_port | default(8090) %}
{% set server_ip = ansible_default_ipv4.address | default(ansible_host | default(inventory_hostname)) %}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plateforme Ansible Debian 13</title>
  <style>
    :root {
      --text-dark: #0f172a;
      --muted: #64748b;
      --white: #ffffff;
      --blue: #2563eb;
      --dark: #0f172a;
      --green: #16a34a;
      --red: #dc2626;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Segoe UI", Arial, Helvetica, sans-serif;
      color: var(--white);
      background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 55%, #22c55e 100%);
      min-height: 100vh;
    }

    .shell {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
      padding: 34px 0 50px;
    }

    .hero {
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(14px);
      border-radius: 28px;
      padding: 34px;
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.28);
    }

    .badge {
      display: inline-block;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.18);
      font-size: 0.92rem;
      font-weight: 700;
      margin-bottom: 14px;
    }

    h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 4vw, 3.4rem);
      line-height: 1.05;
    }

    .subtitle {
      margin: 0;
      max-width: 850px;
      color: rgba(255, 255, 255, 0.86);
      font-size: 1.05rem;
      line-height: 1.5;
    }

    .meta {
      margin-top: 18px;
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .value {
      font-family: Consolas, "Courier New", monospace;
      background: rgba(15, 23, 42, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.16);
      padding: 6px 10px;
      border-radius: 10px;
      word-break: break-all;
    }

    .grid {
      margin-top: 24px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
    }

    .card {
      background: rgba(255, 255, 255, 0.92);
      color: var(--text-dark);
      border-radius: 24px;
      padding: 22px;
      box-shadow: 0 14px 34px rgba(15, 23, 42, 0.18);
    }

    .card h2 {
      margin: 0 0 8px;
      font-size: 1.1rem;
    }

    .muted {
      margin: 0 0 14px;
      color: var(--muted);
    }

    ul {
      margin: 0;
      padding-left: 18px;
    }

    li {
      margin: 7px 0;
      line-height: 1.45;
    }

    .links {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .btn {
      display: inline-block;
      text-decoration: none;
      color: var(--white);
      background: var(--blue);
      padding: 10px 14px;
      border-radius: 12px;
      font-weight: 700;
    }

    .btn.secondary {
      background: var(--dark);
    }

    .status {
      font-weight: 800;
      color: var(--green);
    }

    .status.error {
      color: var(--red);
    }

    .footer {
      margin-top: 22px;
      color: rgba(255, 255, 255, 0.82);
      font-size: 0.95rem;
    }
    html, body {
      overflow-x: hidden;
    }

    .shell {
      width: calc(100% - 24px);
      padding: 20px 0 32px;
    }

    .hero {
      padding: 22px;
      border-radius: 22px;
    }

    .grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .card {
      min-width: 0;
      overflow: hidden;
      padding: 18px;
      border-radius: 20px;
    }

    .value {
      display: inline-block;
      max-width: 100%;
      overflow-wrap: anywhere;
      word-break: break-word;
      white-space: normal;
    }

    .links {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      width: 100%;
      text-align: center;
    }

    .meta .value {
      width: 100%;
    }

    @media (min-width: 760px) {
      .shell {
        width: min(1120px, calc(100% - 32px));
        padding: 34px 0 50px;
      }

      .hero {
        padding: 34px;
      }

      .grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 18px;
      }

      .card {
        padding: 22px;
      }

      .links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
      }

      .btn {
        width: auto;
      }

      .meta .value {
        width: auto;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <section class="hero">
      <div class="badge">Environnement : {{ env_name | default('dev') }}</div>
      <h1>Déploiement Ansible réussi</h1>
      <p class="subtitle">
        Plateforme Debian 13 provisionnée avec Ansible : Nginx, OpenLDAP, MariaDB,
        sécurité SSH, fail2ban et firewall nftables.
      </p>

      <div class="meta">
        <span class="value">Hôte : {{ inventory_hostname }}</span>
        <span class="value">IP : {{ server_ip }}</span>
        <span class="value">HTTP : {{ nginx_http_port | default(80) }}</span>
        <span class="value">phpLDAPadmin : {{ phpldapadmin_port }}</span>
      </div>

      <div class="footer">
        Page générée par Ansible via le rôle nginx_server.
      </div>
    </section>

    <section class="grid">
      <article class="card">
        <h2>Service web</h2>
        <p class="muted">Serveur Nginx</p>

        <p>
          Statut :
          <span id="web-status" class="status">vérification...</span>
        </p>

        <div class="links">
          <a class="btn" href="/healthz" target="_blank" rel="noopener">Ouvrir /healthz</a>
          <a class="btn secondary" href="#" onclick="window.location.reload(); return false;">Recharger</a>
        </div>
      </article>

      <article class="card">
        <h2>phpLDAPadmin</h2>
        <p class="muted">Interface web LDAP</p>

        <div class="links">
          <a class="btn" id="phpldapadmin-link" href="#" target="_blank" rel="noopener">
            Ouvrir phpLDAPadmin
          </a>
        </div>

        <ul>
          <li>Port : <span class="value">{{ phpldapadmin_port }}</span></li>
          <li>Base DN : <span class="value">{{ ldap_base_dn }}</span></li>
          <li>Admin DN : <span class="value">{{ ldap_admin_dn }}</span></li>
        </ul>
      </article>

      <article class="card">
        <h2>OpenLDAP</h2>
        <p class="muted">Annuaire LDAP</p>

        <ul>
          <li>URI : <span class="value" id="ldap-uri"></span></li>
          <li>Base DN : <span class="value">{{ ldap_base_dn }}</span></li>
          <li>Bind DN : <span class="value">{{ ldap_admin_dn }}</span></li>
        </ul>
      </article>

      <article class="card">
        <h2>MariaDB</h2>
        <p class="muted">Base de données applicative</p>

        <ul>
          <li>Base : <span class="value">appdb</span></li>
          <li>Utilisateur : <span class="value">appuser</span></li>
          <li>Commande : <span class="value">mysql -u appuser -p appdb</span></li>
        </ul>
      </article>
    </section>
  </div>

  <script>
    var host = window.location.hostname || "{{ server_ip }}";
    var phpldapadminPort = "{{ phpldapadmin_port }}";

    document.getElementById("phpldapadmin-link").href =
      "http://" + host + ":" + phpldapadminPort + "/";

    document.getElementById("ldap-uri").textContent =
      "ldap://" + host + ":389";

    fetch("/healthz")
      .then(function(response) {
        var status = document.getElementById("web-status");

        if (response.ok) {
          status.textContent = "OK";
          status.classList.remove("error");
        } else {
          status.textContent = "Erreur HTTP " + response.status;
          status.classList.add("error");
        }
      })
      .catch(function() {
        var status = document.getElementById("web-status");
        status.textContent = "Impossible de joindre /healthz";
        status.classList.add("error");
      });
  </script>
</body>
</html>
